/.yarn/** linguist-vendored
# Launchers are executed by Unix shebangs and rejected by `pnpm pack` with CRLF, so a Windows checkout must keep LF.
/packages/tooling/vis/bin/* text eol=lf

# The native tests compare byte for byte against these: a Windows checkout must keep LF.
/packages/tooling/vis/native/cli/tests/fixtures/** text eol=lf
/packages/tooling/vis/__tests__/util/__snapshots__/*.yml text eol=lf
