{
    "allowlists": [
        {
            "description": "Placeholder tokens that look like secrets but clearly aren't (generic-api-key).",
            "targetRules": ["generic-api-key"],
            "regexTarget": "secret",
            "stopwords": [
                "changeme",
                "placeholder",
                "your-secret",
                "your_secret",
                "your-token",
                "your_token",
                "your-api-key",
                "your_api_key",
                "your-password",
                "your_password",
                "your-key",
                "your_key",
                "replace-me",
                "replace_me",
                "not-a-real",
                "not_a_real",
                "redacted",
                "fake-secret",
                "fake_secret",
                "dummy-secret",
                "dummy_secret",
                "example-secret",
                "example_secret",
                "xxxxxx",
                "yyyyyy",
                "zzzzzz",
                "0000000",
                "test-token",
                "test_token",
                "INSERT_YOUR",
                "REPLACE_WITH",
                "REPLACE_ME",
                "PASTE_YOUR",
                "PASTE_HERE",
                "ADD_YOUR",
                "SET_YOUR",
                "TYPE_YOUR",
                "ENTER_YOUR",
                "FILL_YOUR",
                "<YOUR_",
                "<your_",
                "<your-",
                "NEXT_PUBLIC_PLACEHOLDER",
                "NUXT_PUBLIC_PLACEHOLDER",
                "VITE_PLACEHOLDER",
                "REACT_APP_PLACEHOLDER",
                "PUBLIC_PLACEHOLDER"
            ]
        },
        {
            "description": "Template / interpolation syntax that embeds variables, not secrets.",
            "targetRules": ["generic-api-key"],
            "regexTarget": "secret",
            "regexes": [
                "\\$\\{[^}]*\\}",
                "\\{\\{\\s*[^}]+\\s*\\}\\}",
                "(?i)^vault://",
                "(?i)^\\$env:",
                "(?i)^arn:aws:",
                "^\\$[a-zA-Z_][a-zA-Z0-9_.]*$",
                "(?i)^Astro\\.(?:props|locals)\\.",
                "^[a-zA-Z_][a-zA-Z0-9_.]*(?:\\?\\.[a-zA-Z0-9_]+)+$",
                "(?i)^(?:process\\.env|import\\.meta\\.env|env)\\.[A-Z0-9_]+$"
            ]
        }
    ],
    "ruleOverrides": [
        {
            "id": "github-app-token",
            "upstream": "https://github.com/gitleaks/gitleaks/pull/2193",
            "regex": "(?:ghu_[0-9a-zA-Z]{36}|ghs_(?:[0-9a-zA-Z]{36}|[0-9]+_eyJ[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]+))"
        },
        {
            "id": "openai-api-key",
            "upstream": "https://github.com/gitleaks/gitleaks/pull/2240",
            "regex": "\\b(sk-(?:proj-|svcacct-)?[A-Za-z0-9_-]{32,80}T3BlbkFJ[A-Za-z0-9_-]{32,})(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
        },
        {
            "id": "airtable-personnal-access-token",
            "upstream": "https://github.com/gitleaks/gitleaks/pull/2260",
            "keywords": ["pat"]
        },
        {
            "id": "sourcegraph-access-token",
            "upstream": "https://github.com/gitleaks/gitleaks/pull/2109",
            "regex": "(?i)\\b(sgp_(?:[a-fA-F0-9]{16}|local)_[a-fA-F0-9]{40}|sgp_[a-fA-F0-9]{40})(?:[\\x60'\"\\s;]|\\\\[nr]|$)|(?i)[\\w.-]{0,50}?(?:sourcegraph)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([a-fA-F0-9]{40})(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
        },
        {
            "id": "square-access-token",
            "upstream": "https://github.com/gitleaks/gitleaks/pull/2108",
            "regex": "\\b((?:EAAA[\\w-]{60}|sq0atp-[\\w-]{22,43}))(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
            "allowlists": [
                {
                    "description": "Base64 payload carriers where EAAA shows up inside attachments (gitleaks#2093).",
                    "paths": ["(?i)\\.(?:eml|mht|msg|xlsx|docx|pptx|zip|jar|war|ear|apk|ipa)$"]
                }
            ]
        },
        {
            "id": "hashicorp-tf-password",
            "upstream": "https://github.com/gitleaks/gitleaks/pull/2219",
            "regex": "(?i)[\\w.-]{0,50}?(?:administrator_login_password|password)[ \\t]{0,20}(?:=|:{1,3}=|=>|\\?=|:)[ \\t]{0,5}(\"[a-z0-9=_\\-]{8,20}\")(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
        },
        {
            "id": "kubernetes-secret-yaml",
            "upstream": "https://github.com/gitleaks/gitleaks/pull/1953",
            "regex": "(?i)(?:\\bkind:[ \\t]*[\"']?\\bsecret\\b[\"']?(?s:.){0,200}?\\bdata:(?s:.){0,100}?\\s+((?:[\\w.-]+:(?:[ \\t]*(?:\\||>[-+]?)\\s+)?[ \\t]*(?:[\"']?[a-z0-9+/]{10,}={0,3}[\"']?|\\{\\{[ \\t\\w\"|$:=,.-]+}}|\"\"|'')\\s*)+)|\\bdata:(?s:.){0,100}?\\s+((?:[\\w.-]+:(?:[ \\t]*(?:\\||>[-+]?)\\s+)?[ \\t]*(?:[\"']?[a-z0-9+/]{10,}={0,3}[\"']?|\\{\\{[ \\t\\w\"|$:=,.-]+}}|\"\"|'')\\s*)+)(?s:.){0,200}?\\bkind:[ \\t]*[\"']?\\bsecret\\b[\"']?)"
        },
        {
            "id": "private-key",
            "upstream": "https://github.com/gitleaks/gitleaks/issues/1034",
            "allowlists": [
                {
                    "description": "Password-encrypted cosign/sigstore signing keys are meant to be committed (gitleaks#1034).",
                    "regexTarget": "match",
                    "regexes": ["-----BEGIN ENCRYPTED (?:COSIGN|SIGSTORE) PRIVATE KEY-----"]
                }
            ]
        },
        {
            "id": "generic-api-key",
            "upstream": "https://github.com/gitleaks/gitleaks/pull/2229 (+ #2331, #1954)",
            "regex": "(?i)[0-9a-z_.-]{0,50}?(?:access|auth|(?-i:[Aa]pi|API)|credential|creds|key|passw(?:or)?d|secret|token)(?:(?:[ \\t0-9a-z_.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=)|[\\s'\"]{0,3},)[\\x60'\"\\s=]{0,5}([0-9a-z_.=-]{10,150}|[a-z0-9+/][a-z0-9+/]{11,}={0,3})(?:[\\x60'\"\\s;&]|\\\\[nr]|$)",
            "secretGroup": 1,
            "priority": -1,
            "allowlists": [
                {
                    "description": "Editor keybinding chords such as ctrl+shift+down (gitleaks#2195).",
                    "regexTarget": "secret",
                    "regexes": ["(?i)^(?:(?:ctrl|control|shift|alt|cmd|command|meta|win|super|option)\\+){1,5}[a-z0-9]{1,12}$"]
                },
                {
                    "description": "JS instance property assigned to another identifier, e.g. this.vocab=new (gitleaks#2136).",
                    "regexes": ["^(?:this|self)\\.[A-Za-z_$][\\w$]*=[A-Za-z_$][\\w$]*$"]
                },
                {
                    "description": "Swift type-only declarations such as `let privateKey: P256.Signing.PrivateKey` (gitleaks#2183).",
                    "regexTarget": "line",
                    "regexes": ["^\\s*(?:[\\w@()]+\\s+)*(?:let|var)\\s+\\w+\\s*:\\s*[A-Z][\\w.<>, ?]*$"]
                },
                {
                    "description": "Bitnami sealed-secrets ciphertext (encryptedData values) in YAML/JSON manifests, safe to commit (gitleaks#1728).",
                    "regexes": ["^Ag[A-D][0-9A-Za-z+/]{600,}={0,2}$"],
                    "condition": "AND",
                    "paths": ["(?i)\\.(?:ya?ml|json)$"]
                }
            ]
        }
    ]
}
