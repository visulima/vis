{
    "$comment": "Which invocations the Node launcher hands to the native binary (`launcher`: native or node) and what the binary then does with them (`binary`: native answers itself, node delegates). Read by __tests__/native/routing-fixture.test.ts and native/cli/tests/routing.rs; a case without `binary` is checked against the launcher only; `platform` defaults to linux, `interactive` means stdout is a terminal, and `files` are written into the project the binary runs in.",
    "cases": [
        { "args": [], "launcher": "native", "binary": "native" },
        { "args": ["--help"], "launcher": "native", "binary": "native" },
        { "args": ["-h"], "launcher": "native", "binary": "native" },
        { "args": ["help"], "launcher": "native", "binary": "native" },
        { "args": ["help", "install"], "launcher": "native", "binary": "native" },
        { "args": ["status", "--help"], "launcher": "native", "binary": "native" },
        { "args": ["status", "-h"], "launcher": "native", "binary": "native" },
        { "args": ["run", "build", "--", "--help"], "launcher": "node", "binary": "node" },
        { "args": ["run", "build", "--", "-h"], "launcher": "node", "binary": "node" },
        { "args": ["complete", "--", "vis", ""], "launcher": "native", "binary": "native" },
        {
            "args": ["complete", "--help"],
            "launcher": "node",
            "binary": "native",
            "note": "only `complete --` is native; the launcher leaves every other shape to Node"
        },
        {
            "args": ["complete", "bash"],
            "launcher": "node",
            "binary": "native",
            "note": "only `complete --` is native; the launcher leaves every other shape to Node"
        },
        {
            "args": ["complete", "bash", "--help"],
            "launcher": "node",
            "binary": "native",
            "note": "only `complete --` is native; the launcher leaves every other shape to Node"
        },
        { "args": ["completion", "bash"], "launcher": "node", "binary": "node" },
        { "args": ["completion", "--shell=bash"], "launcher": "node", "binary": "node" },
        { "args": ["hook", "run", "pre-commit"], "launcher": "native", "binary": "node", "note": "the runner hands this shape to Node" },
        { "args": ["hook", "install"], "launcher": "node", "binary": "node" },
        {
            "args": ["advisories", "bloom", "status", "--format", "json"],
            "launcher": "native",
            "binary": "node",
            "note": "without --cache-dir the binary hands the call to Node"
        },
        {
            "args": ["advisories", "bloom", "status", "--format", "json", "--cache-dir", "cache"],
            "launcher": "native",
            "binary": "native",
            "env": { "CI": "1" }
        },
        {
            "args": ["advisories", "bloom", "status", "--format", "json", "--cache-dir", "cache"],
            "launcher": "native",
            "binary": "node",
            "note": "the binary answers it natively only in a CI context"
        },
        { "args": ["advisories", "bloom", "sync"], "launcher": "node", "binary": "node" },
        { "args": ["advisories", "status"], "launcher": "node", "binary": "node" },
        { "args": ["ignore", "--help"], "launcher": "native", "binary": "native" },
        {
            "args": ["ignore-all"],
            "launcher": "node",
            "binary": "native",
            "note": "not a command; the binary rejects it as unknown, so the launcher leaves it to Node"
        },
        { "args": ["--version"], "launcher": "native", "binary": "native" },
        { "args": ["-V"], "launcher": "native", "binary": "native" },
        { "args": ["exec", "tsc"], "launcher": "native", "binary": "native" },
        { "args": ["pm", "list"], "launcher": "native", "binary": "native" },
        { "args": ["why", "left-pad"], "launcher": "native", "binary": "native" },
        { "args": ["status", "--json"], "launcher": "node", "binary": "node" },
        { "args": ["run", "build"], "launcher": "node", "binary": "node" },
        { "args": ["-v"], "launcher": "node", "binary": "node" },
        { "args": ["list"], "launcher": "native", "binary": "native", "env": { "CI": "1", "COLUMNS": "80" } },
        { "args": ["list", "--json"], "launcher": "native", "binary": "native", "env": { "CI": "1", "COLUMNS": "80" } },
        { "args": ["list", "--format=table"], "launcher": "native", "binary": "native", "env": { "CI": "1", "COLUMNS": "80" } },
        { "args": ["list", "--format", "json"], "launcher": "native", "binary": "native", "env": { "CI": "1", "COLUMNS": "80" } },
        { "args": ["list", "--deps"], "launcher": "node", "binary": "node", "env": { "CI": "1", "COLUMNS": "80" } },
        { "args": ["list", "extra"], "launcher": "node", "binary": "node", "env": { "CI": "1", "COLUMNS": "80" } },
        { "args": ["list"], "launcher": "node", "binary": "node" },
        { "args": ["list"], "launcher": "node", "env": { "CI": "1", "COLUMNS": "80" }, "interactive": true },
        { "args": ["list", "--help"], "launcher": "native", "binary": "native" },
        { "args": ["cache", "list", "--help"], "launcher": "native", "binary": "native" },
        { "args": ["cache", "size", "--help"], "launcher": "native", "binary": "native" },
        { "args": ["cache", "list", "--format", "json"], "launcher": "native", "binary": "native", "env": { "CI": "1" } },
        { "args": ["cache", "list", "--format=json", "--scope", "all"], "launcher": "native", "binary": "native", "env": { "CI": "1" } },
        { "args": ["cache", "size", "--type", "task", "--format=json"], "launcher": "native", "binary": "native", "env": { "CI": "1" } },
        {
            "args": ["cache", "size", "--format", "json"],
            "launcher": "native",
            "binary": "node",
            "env": { "CI": "1" },
            "note": "the per-user stores need a HOME, which this run does not have"
        },
        {
            "args": ["cache", "list"],
            "launcher": "native",
            "binary": "node",
            "env": { "CI": "1" },
            "note": "a missing cache directory is a pail line, which the binary leaves to Node"
        },
        { "args": ["cache", "list", "--scope", "bogus"], "launcher": "native", "binary": "node", "env": { "CI": "1" } },
        { "args": ["cache", "list", "--format", "json", "--no-color"], "launcher": "native", "binary": "node", "env": { "CI": "1" } },
        { "args": ["cache", "list", "--format", "json"], "launcher": "node", "binary": "node" },
        { "args": ["cache", "list", "--format", "json"], "launcher": "node", "env": { "CI": "1" }, "interactive": true },
        { "args": ["cache", "clean"], "launcher": "node", "binary": "node", "env": { "CI": "1" } },
        {
            "args": ["cache", "list", "--format", "json"],
            "launcher": "native",
            "binary": "node",
            "env": { "CI": "1" },
            "files": { "vis.config.ts": "export default { taskRunner: { cacheDirectory: [\"a\"].join(\"\") } };\n" },
            "note": "a config that has to be evaluated is Node's"
        },
        {
            "args": ["cache", "list", "--format", "json"],
            "launcher": "native",
            "binary": "native",
            "env": { "CI": "1" },
            "files": { "vis.config.ts": "export default { taskRunner: { cacheDirectory: \"custom\" }, branchScopedCache: false };\n" },
            "note": "a literal config is read natively"
        },
        { "args": ["clean"], "launcher": "native", "binary": "native", "env": { "CI": "1", "COLUMNS": "80" } },
        { "args": ["clean", "--dry-run"], "launcher": "native", "binary": "native", "env": { "CI": "1", "COLUMNS": "80" } },
        { "args": ["clean", "--other"], "launcher": "node", "binary": "node", "env": { "CI": "1", "COLUMNS": "80" } },
        { "args": ["clean", "--dry-run", "--dry-run"], "launcher": "node", "binary": "node", "env": { "CI": "1", "COLUMNS": "80" } },
        { "args": ["clean"], "launcher": "node", "binary": "node" },
        { "args": ["clean"], "launcher": "node", "env": { "CI": "1", "COLUMNS": "80" }, "interactive": true },
        { "args": ["clean", "--help"], "launcher": "native", "binary": "native" },
        { "args": ["clean"], "launcher": "node", "binary": "node", "env": { "CI": "1", "COLUMNS": "80", "FORCE_COLOR": "1" } },
        { "args": ["clean"], "launcher": "node", "binary": "node", "env": { "CI": "1", "COLUMNS": "80", "GITHUB_ACTIONS": "true" } },
        { "args": ["clean"], "launcher": "node", "binary": "node", "env": { "CI": "1", "COLUMNS": "80", "TERM": "xterm" } },
        { "args": ["clean"], "launcher": "native", "binary": "native", "env": { "CI": "1", "COLUMNS": "80", "TERM": "dumb" } },
        { "args": ["clean", "--lockfile"], "launcher": "native", "binary": "native", "env": { "CI": "1", "COLUMNS": "80" } },
        { "args": ["clean", "--dry-run"], "launcher": "node", "env": { "CI": "1", "COLUMNS": "80" }, "interactive": true },
        { "args": ["clean", "--lockfile"], "launcher": "node", "env": { "CI": "1", "COLUMNS": "80" }, "interactive": true },
        { "args": ["ignore"], "launcher": "native", "binary": "native", "env": { "CI": "1" } },
        { "args": ["ignore", "--json"], "launcher": "native", "binary": "native", "env": { "CI": "1" } },
        { "args": ["ignore", "--target=npm", "--write"], "launcher": "native", "binary": "native", "env": { "CI": "1" } },
        { "args": ["ignore"], "launcher": "node", "binary": "node" },
        { "args": ["ignore"], "launcher": "node", "binary": "node", "env": { "CI": "1", "FORCE_COLOR": "1" } },
        { "args": ["ignore"], "launcher": "node", "binary": "node", "env": { "CI": "1", "GITHUB_ACTIONS": "true" } },
        { "args": ["ignore"], "launcher": "native", "binary": "native", "env": { "CI": "1", "TERM": "dumb" } },
        { "args": ["ignore", "--target", "slug"], "launcher": "native", "binary": "native", "env": { "CI": "1" } },
        { "args": ["ignore"], "launcher": "node", "env": { "CI": "1" }, "interactive": true },
        { "args": ["remove", "lodash"], "launcher": "native", "binary": "native" },
        {
            "args": ["remove", "lodash"],
            "launcher": "native",
            "binary": "node",
            "files": { "vis.config.ts": "export default { install: { backend: \"aube\" } };\n" },
            "note": "a config that pins the install backend is Node's to read"
        },
        {
            "args": ["remove", "lodash"],
            "launcher": "native",
            "binary": "native",
            "files": { "vis.config.ts": "export default { lint: { enabled: true } };\n" }
        },
        {
            "args": ["remove", "--config=./alternate.ts", "lodash"],
            "launcher": "native",
            "binary": "node",
            "files": { "vis.config.ts": "export default { lint: { enabled: true } };\n" },
            "note": "a global option that moves the config reaches Node"
        },
        { "args": [], "launcher": "native", "platform": "win32" },
        { "args": ["--help"], "launcher": "native", "platform": "win32" },
        { "args": ["-h"], "launcher": "native", "platform": "win32" },
        { "args": ["help", "install"], "launcher": "native", "platform": "win32" },
        { "args": ["status", "--help"], "launcher": "native", "platform": "win32" },
        { "args": ["ignore", "--help"], "launcher": "native", "platform": "win32" },
        { "args": ["clean", "--help"], "launcher": "native", "platform": "win32" },
        { "args": ["clean", "-h"], "launcher": "native", "platform": "win32" },
        { "args": ["ignore"], "launcher": "node", "env": { "CI": "1" }, "platform": "win32" },
        { "args": ["ignore", "--target=npm", "--write"], "launcher": "node", "env": { "CI": "1" }, "platform": "win32" },
        { "args": ["list", "--help"], "launcher": "native", "platform": "win32" },
        { "args": ["--version"], "launcher": "native", "platform": "win32" },
        { "args": ["hook", "run", "pre-commit"], "launcher": "native", "platform": "win32" },
        { "args": ["clean", "--dry-run"], "launcher": "node", "env": { "CI": "1", "COLUMNS": "80" }, "platform": "win32" },
        { "args": ["list"], "launcher": "node", "platform": "win32" },
        { "args": ["cache", "list", "--help"], "launcher": "native", "platform": "win32" },
        { "args": ["cache", "list", "--format", "json"], "launcher": "node", "env": { "CI": "1" }, "platform": "win32" },
        { "args": ["cache", "size"], "launcher": "node", "env": { "CI": "1" }, "platform": "win32" }
    ]
}
