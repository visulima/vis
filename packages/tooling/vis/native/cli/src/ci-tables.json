    "packageManagers": {
        "aube": {
            "exec": "npx",
            "install": "aube install --frozen-lockfile",
            "setup": [
                "npm install -g @endevco/aube"
            ]
        },
        "bun": {
            "exec": "bunx",
            "githubAction": "setupBun",
            "install": "bun install --frozen-lockfile",
            "setup": [
                "npm install -g bun"
            ]
        },
        "npm": {
            "exec": "npx",
            "githubNodeCache": "npm",
            "install": "npm ci",
            "setup": []
        },
        "pnpm": {
            "exec": "pnpm exec",
            "githubAction": "setupPnpm",
            "githubNodeCache": "pnpm",
            "install": "pnpm install --frozen-lockfile",
            "setup": [
                "npm install -g corepack",
                "corepack enable"
            ]
        },
        "yarn": {
            "exec": "yarn",
            "install": "yarn install --immutable",
            "setup": [
                "npm install -g corepack",
                "corepack enable"
            ]
        }
    }
}
