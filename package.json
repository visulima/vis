{
    "name": "visulima-vis-workspace",
    "private": true,
    "description": "Standalone workspace for @visulima/vis and the native packages it builds on",
    "license": "MIT",
    "packageManager": "pnpm@11.28.2",
    "engines": {
        "node": "^22.14.0 || >=24.10.0"
    },
    "scripts": {
        "bench:affected": "nx affected --target=test:bench --parallel --exclude=*-bench,storybook,shared-utils,www --nxBail",
        "build": "nx run-many --target=build --all --parallel",
        "build:affected:packages": "nx affected --target=build --exclude=*-bench,storybook,shared-utils,www --nxBail",
        "build:affected:prod:packages": "nx affected --target=build:prod --exclude=*-bench,storybook,shared-utils,www --nxBail",
        "build:packages": "nx run-many --target=build --parallel --projects=tag:type:package",
        "build:packages:prod": "nx run-many --target=build:prod --parallel --projects=tag:type:package",
        "build:prod": "nx run-many --target=build:prod --all --parallel",
        "lint:affected:attw": "nx affected --target=lint:attw --parallel --exclude=*-bench,storybook,shared-utils,www",
        "lint:affected:eslint": "nx affected --target=lint:eslint --parallel --exclude=*-bench,storybook,shared-utils,www",
        "lint:affected:package-json": "nx affected --target=lint:package-json --parallel --exclude=*-bench,storybook,shared-utils,www",
        "lint:affected:types": "nx affected --target=lint:types --parallel --exclude=*-bench,storybook,shared-utils,www",
        "lint:attw": "nx run-many --target=lint:attw --all --parallel",
        "lint:eslint": "nx run-many --target=lint:eslint --all --parallel",
        "lint:eslint:fix": "nx run-many --target=lint:eslint:fix --all --parallel",
        "lint:package-json": "nx run-many --target=lint:package-json --parallel --projects=tag:type:package",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "nx run-many --target=lint:types --all --parallel",
        "test": "nx run-many --target=test --all --parallel",
        "test:affected": "nx affected --target=test --parallel --exclude=*-bench,storybook,shared-utils,www",
        "test:affected:coverage": "nx affected --target=test:coverage --parallel --exclude=*-bench,storybook,shared-utils,www",
        "test:coverage": "nx run-many --target=test:coverage --all --parallel",
        "graph": "nx dep-graph"
    },
    "devDependencies": {
        "@anolilab/multi-semantic-release": "catalog:prod",
        "@anolilab/prettier-config": "catalog:lint",
        "pkg-pr-new": "catalog:prod",
        "prettier": "catalog:lint",
        "semantic-release": "catalog:cli",
        "typescript": "catalog:tsc"
    },
    "workspaces": [
        "packages/*/*",
        "shared/*"
    ],
    "dependencies": {
        "nx": "catalog:prod"
    }
}
