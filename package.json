{
    "name": "visulima-vis-workspace",
    "private": true,
    "description": "Standalone workspace for @visulima/vis and the native packages it builds on",
    "license": "MIT",
    "packageManager": "pnpm@11.28.2",
    "engines": {
        "node": "^22.14.0 || >=24.10.0"
    },
    "scripts": {
        "build": "pnpm -r run build",
        "build:prod": "pnpm -r run build:prod",
        "test": "pnpm -r run test",
        "lint:eslint": "pnpm -r run lint:eslint",
        "lint:prettier": "prettier --check .",
        "lint:types": "pnpm -r run lint:types"
    },
    "devDependencies": {
        "prettier": "catalog:lint",
        "typescript": "catalog:tsc"
    }
}
